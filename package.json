{
  "name": "@matdata/yasgui-chart-plugin",
  "private": false,
  "version": "0.1.0",
  "description": "YASGUI plugin for visualising SPARQL SELECT results as bar, line, pie, scatter and histogram charts",
  "main": "dist/yasgui-chart-plugin.cjs.js",
  "module": "dist/yasgui-chart-plugin.esm.js",
  "unpkg": "dist/yasgui-chart-plugin.min.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build --base=/yasgui-chart-plugin/",
    "build": "node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matdata-eu/yasgui-chart-plugin.git"
  },
  "keywords": [
    "yasgui",
    "yasr",
    "sparql",
    "rdf",
    "chart",
    "visualization"
  ],
  "author": "Matdata",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Matdata-eu/yasgui-chart-plugin/issues"
  },
  "homepage": "https://github.com/Matdata-eu/yasgui-chart-plugin#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "n3": "^2.13.11"
  },
  "devDependencies": {
    "@matdata/yasgui": "^6.10.0",
    "@types/jest": "^30.0.0",
    "@types/n3": "^1.26.4",
    "@types/node": "^26.6.5",
    "cssnano": "^7.1.9",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.29",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
